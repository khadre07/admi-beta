# Streamlit Community Cloud — secrets de l'application
# Coller ce contenu dans : Settings -> Secrets (interface web).
# Localement : copier ce fichier en .streamlit/secrets.toml (NE PAS committer).

# --- Base de données (Supabase, Neon, Render, RDS...) -----------------------
# Supabase : Project Settings -> Database -> Connection string -> URI
# Important : utiliser le port 5432 (session pooler : 6543) et encoder le mot de passe.
DATABASE_URL = "postgresql+psycopg2://postgres:MOT_DE_PASSE@db.XXXX.supabase.co:5432/postgres"

# --- Licence AMI ------------------------------------------------------------
# Clé HMAC utilisee pour signer et verifier les codes de licence.
# Doit etre identique dans licgen.py et l'application. Garder confidentielle.
ADMI_LICENSE_SECRET = "remplacer-par-une-chaine-aleatoire-longue"

# Code de licence pre-active pour l'instance (sinon ecran de licence au demarrage).
# Generer avec : ADMI_LICENSE_SECRET="..." python licgen.py
ADMI_LICENSE_CODE = "AMI-XXXX-XXXX-XXXX-XXXX"

# --- Optionnel : notification de mise a jour --------------------------------
# ADMI_UPDATE_URL = "https://exemple.com/admi-update.json"
